# Every setting the backend binaries read, with its default where it has one.
# Copy to .env for local development; the binaries read .env on start. A
# deployment sets the same names in its environment (README, "Deploying").
# A setting left empty counts as not set.

# ---- Database ---------------------------------------------------------------

# The two roles keep the names exchange (the schema owner) and exchange_app
# (the application role): the migrations grant to exchange_app by name, and a
# migration that has been applied is never edited (backend/migrations/README.md).

# Connection used by the api and worker processes: the restricted application
# role, which cannot rewrite history (DESIGN.md §13.2). Required.
DATABASE_URL=postgres://exchange_app:exchange_app@127.0.0.1:5432/yuppers

# Connection used by the migrate binary: the schema owner. Required by
# migrate, which falls back to DATABASE_URL in development.
MIGRATION_DATABASE_URL=postgres://exchange:exchange@127.0.0.1:5432/yuppers

# For a platform whose only connection string is the owner's, such as Render
# (docs/deploy-render.md); leave these unset otherwise.
#
# DATABASE_HOST, DATABASE_PORT (optional) and DATABASE_NAME, in place of
# DATABASE_URL (never both): where the database is, with no credentials. The
# api, the worker and replay-deletions connect there as exchange_app with
# APP_DB_PASSWORD.
#DATABASE_HOST=
#DATABASE_PORT=
#DATABASE_NAME=
# The older way, ignored while DATABASE_HOST is set: any connection string
# for the database, whose user and password are replaced with exchange_app
# and APP_DB_PASSWORD. Only its host, port, database and options are used,
# but the owner's password is in it, so prefer the three above.
#DATABASE_SERVER_URL=
# The application role's password: at least 16 printable ASCII characters,
# no spaces. Used with DATABASE_SERVER_URL, and by migrate when it creates
# the role (below). A secret.
#APP_DB_PASSWORD=
# `true` has migrate create exchange_app with APP_DB_PASSWORD before
# migrating, if no such role exists (the owner must be allowed to create
# roles), and stop if the role, new or old, can do more than log in. An
# existing role's password is never changed. Default false: the role is
# created beforehand, as docker/postgres-init.sql does.
#MIGRATE_CREATE_APP_ROLE=

# ---- The service ------------------------------------------------------------

# Which build is running is built into the image (Dockerfile: the GIT_SHA and
# BUILD_TIME build arguments) and reported in GET /v1/meta, the
# X-Yuppers-Version header, the first log line and yuppers_build_info. A
# build without them (cargo build on this machine) reads these at run time
# instead, then Render's RENDER_GIT_COMMIT; with none, the commit is
# `unknown`. Rarely set by hand.
#GIT_SHA=
#BUILD_TIME=

# Where the web app is served from, without a trailing slash. Cookie sessions
# are honored only for requests from this origin, and notification emails
# link into it. Required. When the API serves the web app itself (WEB_DIR),
# this is the API's own public origin; with HTTPS, responses carry HSTS.
WEB_ORIGIN=http://localhost:5173

# Keys the stored hashes of one-time codes. Required, at least 32 bytes;
# generate a real one for any shared environment, for example with
# `openssl rand -hex 32`, and never commit it.
APP_SECRET=development-only-secret-do-not-use-anywhere-else

# Encrypts every email address and phone number the database holds
# (backend/src/contact; README, "Contact details at rest"). Required by the
# api, the worker, migrate, staff, contact-data and replay-deletions: 32
# random bytes in base64, apart from APP_SECRET. The value here is published,
# for development only: every process refuses it once WEB_ORIGIN is not this
# machine (localhost or a loopback address), migrate and contact-data also
# once the database is not (so `docker compose --profile full` needs one of
# your own; docker-compose.yml says how), and every process refuses any key
# that decodes to printable text. For any shared environment generate one with
# `openssl rand -base64 32`, never commit it, and KEEP A COPY OUTSIDE THE
# PLATFORM (a password manager): without it every address and number in the
# database and in its backups is unrecoverable, and nobody can sign in by
# them. Never written to a log or an error.
CONTACT_DATA_KEY=caRGia2fmQ1tSAu6rulYEdw2aTw9YK6HguX6H6SWMLU=
# While rotating (docs/operations.md, "Contact data key"): the key being
# replaced, which then only decrypts, until `contact-data rotate` reports
# that nothing is left under it. Default: none.
CONTACT_DATA_KEY_PREVIOUS=

# Address and port the API listens on. Default 127.0.0.1:8080. The container
# image sets 0.0.0.0:8080.
BIND_ADDR=127.0.0.1:8080

# A directory holding the built web app (`npm run build:web` writes
# apps/web/dist) for the API to serve alongside itself: each language's entry
# page at /{language}/i, the app's page for every other unknown path, hashed
# assets cached for a year. Default: none, the API serves no pages. The
# container image sets /srv/web.
WEB_DIR=

# Which request header, if any, names the requester's network address, and how
# many proxies in a row add to it. Default: none, the connection's peer is the
# requester, and any such header is ignored. Behind one reverse proxy or a
# CDN, name its header (X-Forwarded-For, CF-Connecting-IP, Fly-Client-IP, ...);
# with a chain of proxies that each append to X-Forwarded-For, say how many,
# so the right entry is taken and one a client sent itself is not (default 1
# once a header is named). The RFC 7239 `Forwarded` header is not read and is
# refused. Without a header the API warns at start, and with one it warns
# about once a minute while the header is missing or unreadable: such
# requests are all counted as the proxy's address. The address is recorded
# with each signature (DESIGN.md §8).
TRUSTED_PROXY_HEADER=
TRUSTED_PROXIES=

# Limits on signing in (DESIGN.md §8), counted against the requester's
# network address (above; an IPv6 requester by its /64) and against the email
# address or phone number.
# Each is a whole number of 1 or more. Zero is refused at start, not read as
# "no limit", and no value turns a limit off: to get one out of the way, as
# the end-to-end tests and the load check do, set it high. Behind a proxy,
# name its header above, or every requester shares the proxy's address.
# Sign-in codes one address may ask for per hour. Default 10.
SIGN_IN_CODE_REQUESTS_PER_ADDRESS_PER_HOUR=
# Wrong codes one email address or phone number may take per UTC day, after
# which even the right code is refused until the day ends. Default 20.
SIGN_IN_FAILED_GUESSES_PER_IDENTIFIER_PER_DAY=
# What bounds guessing at codes is that daily cap, the five wrong guesses
# each code survives, and the limit on code requests above, since every code
# guessed at was asked for first. Wrong codes are not limited per address: a
# limit there could only answer differently where someone had just asked for
# a code, or refuse right codes to everyone sharing the address.
# SIGN_IN_FAILED_GUESSES_PER_ADDRESS_PER_HOUR, a setting once, is refused at
# start if set.

# Log level and filter (tracing_subscriber EnvFilter syntax). Default info.
RUST_LOG=info

# How each log line is written, for every binary. Default text.
#   text  one readable line per event
#   json  one JSON object per line, for a log collector
# docs/operations.md lists the fields. No log line holds a request body, a
# query string, a token, a cookie, a one-time code, an email address or a
# phone number, except the codes and email addresses the development
# deliveries below write. Those write a phone number masked, as +1••••••••67.
LOG_FORMAT=text

# Where the api, or the worker, serves its metrics (Prometheus text format,
# GET /metrics), as an address and port such as 0.0.0.0:9100. Default: none,
# no metrics listener. Always a port of its own, never the API's, and one a
# deployment exposes only to whatever collects the metrics. The api and the
# worker each read it; give each its own when they share a host.
METRICS_ADDR=

# ---- Delivery ---------------------------------------------------------------

# How one-time codes reach people. Required, no default, so the development
# delivery is never used by accident:
#   log   writes each code to the API's log, which is where you read it to
#         sign in. Development only.
#   resend  emails it through Resend's API, with RESEND_API_KEY below.
#   smtp    emails it through the SMTP server below.
# This covers email addresses always, and phone numbers too while
# SMS_CODE_DELIVERY is off: `log` writes their codes to the log as well,
# `resend` and `smtp` refuse them (the person is told the service is
# unavailable).
CODE_DELIVERY=log

# How one-time codes reach phone numbers. Default off.
#   off     as above, with none of the rules of text messages.
#   log     the service makes the code and writes it to the API's log, the
#           number masked, which is where you read it; counted, capped and
#           refused after STOP as a text would be. Development only (the
#           end-to-end tests use it).
#   verify  Twilio Verify makes the code, texts it from Twilio's own senders
#           in its own template, and checks it: no messaging campaign is
#           needed. Uses the account and credential below, and the two
#           Verify services after them. Each text costs money, and each
#           approved code more; see SMS_MAX_PER_HOUR.
SMS_CODE_DELIVERY=
# Required for verify: two Verify services (VA followed by 32 hexadecimal
# digits), each with the friendly name "Yuppers.app": one for signing in
# and confirming a number added to an account, one for deleting an account.
# They must differ: a Verify service resends one number the same code for
# ten minutes, so one service for both would let a sign-in code confirm a
# deletion. docs/deploy-render.md says how to create them.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_DELETION_SERVICE_SID=

# How agreement updates by text ("Yuppers.app agreement updates": DESIGN.md
# §12; README, "Text updates") are sent, by the worker. Default off. It sends
# no codes: SMS_CODE_DELIVERY does.
#   off     no update is offered, queued or sent.
#   log     writes each text message to the worker's log, number masked.
#           Development only.
#   twilio  sends it through Twilio's Messages API with the account below,
#           from the number registered for the program's campaign. Each
#           message costs money; see SMS_MAX_PER_HOUR.
# With it on, the worker also needs APP_SECRET, to count its texts under the
# hourly caps below with the api's codes.
SMS_DELIVERY=
# The Twilio account, for twilio and for verify: the account SID (AC
# followed by 32 hexadecimal digits) and exactly one credential for it; and,
# for twilio only, the sender, either a number of the account in
# international form (+15551234567) or a Messaging Service SID (MG...). The
# credential is either
#   an API key (recommended): SMS_API_KEY_SID (SK followed by 32 hexadecimal
#           digits) and SMS_API_KEY_SECRET, both. A standard key is enough,
#           and it can be revoked without touching the account; or
#   SMS_AUTH_TOKEN, the account's auth token.
# Setting both kinds, neither, or half a key stops the start. Secrets are
# never written to a log.
SMS_ACCOUNT_SID=
SMS_API_KEY_SID=
SMS_API_KEY_SECRET=
SMS_AUTH_TOKEN=
SMS_FROM=
# The account's auth token, which checks the signature Twilio puts on the
# texts people send back (STOP, START), posted to /v1/sms/inbound. Twilio
# signs with the auth token even when the service sends with an API key, so
# with an API key this is needed for STOP and START to be recorded; with
# SMS_AUTH_TOKEN set, that is used and this may stay empty. Without either,
# the webhook refuses every request. A secret; never written to a log.
SMS_WEBHOOK_AUTH_TOKEN=
# Agreement update texts one person may be queued per UTC day, confirmations
# included, to bound what an agreement changed over and over costs. Past it,
# that day's further changes go by email and push only. Default 20. A whole
# number of 1 or more.
SMS_UPDATES_PER_PERSON_PER_DAY=
# Texts the whole service may send per hour, codes and agreement updates
# together, whoever asks and to whatever number, on top of the limits per
# number and per address. Past it, a code for a phone number is refused with
# TOO_MANY_REQUESTS until the hour turns (UTC), and an update waits. Default
# 50. A whole number of 1 or more. Only messages the provider takes count:
# one it refuses gives its place back.
SMS_MAX_PER_HOUR=
# Of those, how many may go per hour to numbers beginning alike (the country
# code and the next three digits: the area code for +1), so that a few
# requesters cannot use up the whole cap. Default 10. A whole number of 1 or
# more.
SMS_MAX_PER_PREFIX_PER_HOUR=
# The country calling codes whose phone numbers the service takes, comma
# separated (+1 or +1,+52). A code for any other number, or adding one to an
# account, is refused with PHONE_COUNTRY_NOT_SERVED before anything is counted
# or sent. Default +1. Applies with SMS_CODE_DELIVERY off as well.
SMS_ALLOWED_COUNTRY_CODES=
# Of +1, the whole North American Numbering Plan, which parts are taken, by
# area code (backend/src/nanp.rs): US (the 50 states and DC), or US,CA to add
# Canada. The Caribbean and Pacific countries, the US territories and
# toll-free numbers are never taken: refused with PHONE_COUNTRY_NOT_SERVED,
# codes and agreement updates alike. Default US. Set the SMS provider's
# geographic permissions to match, Verify's included (docs/deploy-render.md).
SMS_ALLOWED_REGIONS=

# How push notifications reach the app, read by the worker (which sends
# them) and the api (which tells the apps whether to offer them). Default off.
#   off   nothing is offered or sent; anything queued for push is closed.
#   log   the worker writes each notification to its log, token masked.
#         Development only.
#   expo  the worker sends them through Expo's push service, which passes
#         them to Apple and Google with the credentials uploaded to the Expo
#         project (docs/mobile-release.md).
# Email is sent as before either way.
PUSH_DELIVERY=
# The Expo project's access token, needed only if push security is turned
# on for the project in Expo's settings. Never written to a log.
EXPO_ACCESS_TOKEN=

# How notification emails reach people. Required, no default, for the same
# reason:
#   log   the worker writes each email to its log. Development only.
#   resend  the worker sends it through Resend's API, with RESEND_API_KEY.
#           A retry carries the same Idempotency-Key, so Resend never sends
#           one notification twice; an address Resend refuses (422) is not
#           tried again.
#   smtp    the worker sends it through the SMTP server below.
NOTIFICATION_DELIVERY=log

# The sender of every email, whichever delivery sends it, with an optional
# name: `Yuppers <no-reply@example.com>`, on a domain verified with the
# provider. Required when either delivery above is `resend` or `smtp`; where
# it is unset, SMTP_FROM, its older name, is read instead. Its address,
# without the name, is public: GET /v1/meta names it as `code_sender`, and
# the sign-in screens tell people to look for it.
EMAIL_FROM=

# Resend's API key (re_...), used when either delivery above is `resend`;
# the api and the worker refuse to start without it then. Give it sending
# access only, restricted to the sending domain. Never written to a log or
# an error.
RESEND_API_KEY=

# The SMTP server, used when either delivery above is `smtp`. Nearly every
# email provider offers SMTP; these are the values it gives you. Resend's,
# for example: SMTP_HOST=smtp.resend.com, SMTP_TLS=starttls (port 587),
# SMTP_USERNAME=resend and the API key as SMTP_PASSWORD.
# Required then: SMTP_HOST, and EMAIL_FROM or SMTP_FROM.
SMTP_HOST=
# How the connection is protected. Default tls.
#   tls       TLS from the first byte (SMTPS), usually port 465
#   starttls  plain connection upgraded with STARTTLS before anything else is
#             said, usually port 587; a server that cannot upgrade is refused
#   none      plain text throughout: a relay on this host or a test server,
#             never a server reached over a network. Refused at startup
#             unless SMTP_HOST is this host (localhost, 127.0.0.0/8, ::1) and
#             no SMTP_USERNAME or SMTP_PASSWORD is set.
SMTP_TLS=tls
# `true` lets SMTP_TLS=none reach another host, or send credentials, in plain
# text: for a test server only, such as one in a container next to this one.
# Default false.
SMTP_ALLOW_PLAINTEXT_REMOTE=
# Default: the usual port for SMTP_TLS (465, 587 or 25).
SMTP_PORT=
# Both or neither. The password is never written to a log or an error.
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender's older name, read only where EMAIL_FROM is unset. Prefer
# EMAIL_FROM.
SMTP_FROM=

# The oldest build of each client that may still change anything. A client
# below its minimum is told to update, and its changes are refused with
# CLIENT_TOO_OLD. Dotted whole numbers such as 1.4.0; unset or empty means no
# minimum, which is the default.
#MIN_CLIENT_VERSION_WEB=
#MIN_CLIENT_VERSION_IOS=
#MIN_CLIENT_VERSION_ANDROID=

# Universal links (iOS) and app links (Android): which apps may open the
# invitation links and exchange pages (/exchanges/...) of WEB_ORIGIN in place
# of the browser. Served at
# /.well-known/apple-app-site-association and /.well-known/assetlinks.json;
# a file whose setting is unset is not served. A value that is not one stops
# the API at start. See docs/mobile-release.md.
# APPLE_APP_ID: the team ID and bundle ID, such as ABCDE12345.app.yuppers;
# several may be given, separated by commas.
#APPLE_APP_ID=
# The SHA-256 fingerprints of the certificates the Android app is signed
# with (the Play app signing key, and the upload key for internal builds),
# as colon-separated hex pairs, separated by commas.
#ANDROID_SHA256_CERT_FINGERPRINTS=
# Default: app.yuppers.
#ANDROID_PACKAGE=

# ---- Wallet passes ----------------------------------------------------------

# Apple Wallet and Google Wallet passes (docs/wallet.md). Each platform is off
# until all of its settings are given, and a platform half configured stops
# the api and the worker at start. Both processes read the same settings.
# Certificates and keys are PEM, given as the text itself or as the path of
# a file holding it; the keys are secrets, for the platform's secret store.
#APPLE_PASS_TYPE_ID=pass.app.yuppers
# Ten letters and digits.
#APPLE_TEAM_ID=
# The pass type certificate, its unencrypted private key, and Apple's WWDR
# intermediate certificate that issued it.
#APPLE_PASS_CERT=
#APPLE_PASS_KEY=
#APPLE_WWDR_CERT=
# The Google Wallet issuer ID, and the service account's JSON key file (its
# path, or the JSON itself).
#GOOGLE_WALLET_ISSUER_ID=
#GOOGLE_WALLET_SERVICE_ACCOUNT=
# How the worker sends pass updates. Required once a platform is set, no
# default, like the other deliveries:
#   log   writes each push and object update to the worker's log. Development.
#   live  pushes through Apple's push service and patches through the Google
#         Wallet API.
#WALLET_DELIVERY=
# How much a pass's status line says, on a face a phone shows without being
# unlocked (DESIGN.md §11 makes status on the lock screen opt-in):
#   neutral   In force for every agreement in force, and no next due date.
#             The default.
#   detailed  Waiting for you, Disputed, Overdue, Due soon or In force, and
#             the next due date.
#WALLET_STATUS_ON_FACE=
